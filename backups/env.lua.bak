hl.env("EDITOR", "nano")
hl.env("VISUAL", "nano")

-- -----------------------------------------------------
-- Environment Variables
-- name: "Nvidia"
-- -----------------------------------------------------
-- NVIDIA https://wiki.hyprland.org/Nvidia/
hl.env("GBM_BACKEND", "nvidia-drm")
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("SDL_VIDEODRIVER", "wayland")

-- VA-API hardware video acceleration
hl.env("NVD_BACKEND", "direct")

-- FOR VM and POSSIBLY NVIDIA
hl.env("WLR_RENDERER_ALLOW_SOFTWARE", 1)

-- Multi GPU (integrated + nvidia)
-- check this post https://wiki.hypr.land/Configuring/Multi-GPU/
hl.env("AQ_DRM_DEVICES", "/dev/dri/nvidia:/dev/dri/intel-igpu")

-- Electron apps (like Discord) on Wayland
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")

-- Docker
hl.env("DOCKER_HOST", "unix:///run/user/" .. UID .. "/docker.sock")

-- Input methods
hl.env("GTK_IM_MODULE", "fcitx")
hl.env("QT_IM_MODULE", "fcitx")
hl.env("XMODIFIERS", "@im=fcitx")
hl.env("SDL_IM_MODULE", "fcitx")
