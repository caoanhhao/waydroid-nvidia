From c5af4b222476d1fd2d660917d218a254197a9ed3 Mon Sep 17 00:00:00 2001
From: caoanhhao <caoanhhao@users.noreply.github.com>
Date: Thu, 5 Nov 2026 13:26:59 +0700
Subject: [PATCH] venus/android: drop input attachment usage for linear AHB
 images

Android 13's ANGLE adds VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT to every
sampled AHardwareBuffer image.  NVIDIA rejects that usage for
DRM_FORMAT_MOD_LINEAR images (vkCreateImage and the format query
return VK_ERROR_FORMAT_NOT_SUPPORTED), and gralloc allocates buffers
with CPU usage linear, so the deferred AHB image creation fails at
vkAllocateMemory and eglCreateImageKHR returns EGL_BAD_PARAMETER.

Input attachments are only used for framebuffer fetch, so drop the bit
for linear AHB images instead of failing the import.

caoanhhao used AI to code
---
 src/virtio/vulkan/vn_android.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/virtio/vulkan/vn_android.c b/src/virtio/vulkan/vn_android.c
index 31eb52f..76735a8 100644
--- a/src/virtio/vulkan/vn_android.c
+++ b/src/virtio/vulkan/vn_android.c
@@ -159,6 +159,14 @@ vn_android_ahb_image_init(struct vn_device *dev,
       return result;
    __vk_append_struct(create_info, &mod_info);
 
+   /* ANGLE adds INPUT_ATTACHMENT to every sampled AHB image, but some
+    * renderers (NVIDIA) reject it for DRM_FORMAT_MOD_LINEAR, which gralloc
+    * uses for buffers with CPU usage.  Input attachments are only needed for
+    * framebuffer fetch, so drop the bit rather than fail the import.
+    */
+   if (mod_info.drmFormatModifier == DRM_FORMAT_MOD_LINEAR)
+      create_info->usage &= ~VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT;
+
    VkExternalMemoryImageCreateInfo external_info = {
       .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
       .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
