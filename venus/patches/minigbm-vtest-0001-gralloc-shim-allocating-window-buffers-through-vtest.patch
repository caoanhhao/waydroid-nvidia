+#pragma once
+
+#include <stdbool.h>
+
+struct gbm_device;
+struct gbm_bo;
+
+struct alloc_args {
+	struct gbm_device *gbm;
+	uint32_t width;
+	uint32_t height;
+	uint32_t drm_format;
+	bool use_scanout;
+	bool force_linear;
+	bool needs_map_stride;
+	int out_fd;
+	uint32_t out_stride;
+	uint64_t out_modifier;
+	uint32_t out_map_stride;
+};
+
+struct gbm_ops {
+	uint32_t (*get_gbm_format)(uint32_t drm_format);
+
+	struct gbm_device *(*dev_create)(int fd);
+
+	void (*dev_destroy)(struct gbm_device *gbm);
+
+	// ALLOCATOR ONLY
+	int (*alloc)(struct alloc_args *args);
+
+	// MAPPER ONLY
+	struct gbm_bo *(*import)(struct gbm_device *gbm, int buf_fd, uint32_t width,
+				 uint32_t height, uint32_t stride, uint64_t modifier,
+				 uint32_t drm_format);
+
+	void (*free)(struct gbm_bo *bo);
+
+	void (*map)(struct gbm_bo *bo, int w, int h, void **addr, void **map_data);
+
+	void (*unmap)(struct gbm_bo *bo, void *map_data);
+};
diff --git a/vtest_alloc_client.c b/vtest_alloc_client.c
new file mode 100644
index 0000000..234da61
--- /dev/null
+++ b/vtest_alloc_client.c
@@ -0,0 +1,216 @@
+/*
+ * Copyright 2026 waydroid-nvidia contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vtest_alloc_client.h"
+
+#include <errno.h>
+#include <stdbool.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "vtest_protocol.h"
+
+#define ALLOC_PROTOCOL_VERSION 6
+
+static int
+write_all(int sock, const void *buf, size_t size)
+{
+   const char *p = buf;
+   while (size) {
+      const ssize_t ret = write(sock, p, size);
+      if (ret < 0 && errno == EINTR)
+         continue;
+      if (ret <= 0)
+         return -EPIPE;
+      p += ret;
+      size -= ret;
+   }
+   return 0;
+}
+
+static int
+read_all(int sock, void *buf, size_t size)
+{
+   char *p = buf;
+   while (size) {
+      const ssize_t ret = read(sock, p, size);
+      if (ret < 0 && errno == EINTR)
+         continue;
+      if (ret <= 0)
+         return -EPIPE;
+      p += ret;
+      size -= ret;
+   }
+   return 0;
+}
+
+static int
+receive_fd(int sock)
+{
+   char cmsg_buf[CMSG_SPACE(sizeof(int))];
+   char dummy;
+   struct iovec iov = { .iov_base = &dummy, .iov_len = sizeof(dummy) };
+   struct msghdr msg = {
+      .msg_iov = &iov,
+      .msg_iovlen = 1,
+      .msg_control = cmsg_buf,
+      .msg_controllen = sizeof(cmsg_buf),
+   };
+
+   ssize_t ret;
+   do {
+      ret = recvmsg(sock, &msg, MSG_CMSG_CLOEXEC);
+   } while (ret < 0 && errno == EINTR);
+   if (ret <= 0)
+      return -EPIPE;
+
+   struct cmsghdr *cmsg = CMSG_FIRSTHDR(&msg);
+   if (!cmsg || cmsg->cmsg_level != SOL_SOCKET || cmsg->cmsg_type != SCM_RIGHTS)
+      return -EPIPE;
+
+   int fd;
+   memcpy(&fd, CMSG_DATA(cmsg), sizeof(fd));
+   return fd;
+}
+
+static int
+negotiate_version(int sock, uint32_t *out_version)
+{
+   uint32_t hdr[VTEST_HDR_SIZE];
+   uint32_t busy_wait[VCMD_BUSY_WAIT_SIZE] = { 0, 0 };
+   uint32_t dummy;
+   int ret;
+
+   /* ping, plus a dummy busy wait so an old server without ping still
+    * answers something (same as Mesa's vtest backend)
+    */
+   hdr[VTEST_CMD_LEN] = VCMD_PING_PROTOCOL_VERSION_SIZE;
+   hdr[VTEST_CMD_ID] = VCMD_PING_PROTOCOL_VERSION;
+   if ((ret = write_all(sock, hdr, sizeof(hdr))))
+      return ret;
+   hdr[VTEST_CMD_LEN] = VCMD_BUSY_WAIT_SIZE;
+   hdr[VTEST_CMD_ID] = VCMD_RESOURCE_BUSY_WAIT;
+   if ((ret = write_all(sock, hdr, sizeof(hdr))) ||
+       (ret = write_all(sock, busy_wait, sizeof(busy_wait))))
+      return ret;
+
+   if ((ret = read_all(sock, hdr, sizeof(hdr))))
+      return ret;
+   const bool has_ping = hdr[VTEST_CMD_ID] == VCMD_PING_PROTOCOL_VERSION;
+   if (has_ping && (ret = read_all(sock, hdr, sizeof(hdr))))
+      return ret;
+   if ((ret = read_all(sock, &dummy, sizeof(dummy))))
+      return ret;
+   if (!has_ping)
+      return -EPROTONOSUPPORT;
+
+   uint32_t version = ALLOC_PROTOCOL_VERSION;
+   hdr[VTEST_CMD_LEN] = VCMD_PROTOCOL_VERSION_SIZE;
+   hdr[VTEST_CMD_ID] = VCMD_PROTOCOL_VERSION;
+   if ((ret = write_all(sock, hdr, sizeof(hdr))) ||
+       (ret = write_all(sock, &version, sizeof(version))) ||
+       (ret = read_all(sock, hdr, sizeof(hdr))) ||
+       (ret = read_all(sock, &version, sizeof(version))))
+      return ret;
+
+   *out_version = version;
+   return 0;
+}
+
+int
+vtest_alloc_connect(const char *socket_path, const char *client_name)
+{
+   struct sockaddr_un un = { .sun_family = AF_UNIX };
+   if (strlen(socket_path) >= sizeof(un.sun_path))
+      return -ENAMETOOLONG;
+   strcpy(un.sun_path, socket_path);
+
+   const int sock = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+   if (sock < 0)
+      return -errno;
+   if (connect(sock, (struct sockaddr *)&un, sizeof(un)) < 0) {
+      const int err = -errno;
+      close(sock);
+      return err;
+   }
+
+   /* the first command must be VCMD_CREATE_RENDERER */
+   const uint32_t name_size = strlen(client_name) + 1;
+   uint32_t hdr[VTEST_HDR_SIZE] = { name_size, VCMD_CREATE_RENDERER };
+   uint32_t version = 0;
+   int ret = write_all(sock, hdr, sizeof(hdr));
+   if (!ret)
+      ret = write_all(sock, client_name, name_size);
+   if (!ret)
+      ret = negotiate_version(sock, &version);
+   if (!ret && version < ALLOC_PROTOCOL_VERSION)
+      ret = -EPROTONOSUPPORT;
+   if (ret) {
+      close(sock);
+      return ret;
+   }
+
+   return sock;
+}
+
+int
+vtest_alloc_dmabuf_image(int sock,
+                         uint32_t width,
+                         uint32_t height,
+                         uint32_t drm_format,
+                         uint32_t flags,
+                         const uint64_t *modifiers,
+                         uint32_t modifier_count,
+                         struct vtest_alloc_buffer *out)
+{
+   uint32_t req[VCMD_ALLOC_DMABUF_IMAGE_SIZE(VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS)];
+   uint32_t hdr[VTEST_HDR_SIZE];
+   uint32_t resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE];
+   int ret;
+
+   if (modifier_count > VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS)
+      modifier_count = VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS;
+
+   const uint32_t len = VCMD_ALLOC_DMABUF_IMAGE_SIZE(modifier_count);
+   req[VCMD_ALLOC_DMABUF_IMAGE_WIDTH] = width;
+   req[VCMD_ALLOC_DMABUF_IMAGE_HEIGHT] = height;
+   req[VCMD_ALLOC_DMABUF_IMAGE_FORMAT] = drm_format;
+   req[VCMD_ALLOC_DMABUF_IMAGE_FLAGS] = flags;
+   req[VCMD_ALLOC_DMABUF_IMAGE_MODIFIER_COUNT] = modifier_count;
+   for (uint32_t i = 0; i < modifier_count; i++) {
+      req[VCMD_ALLOC_DMABUF_IMAGE_MODIFIER_LO(i)] = (uint32_t)modifiers[i];
+      req[VCMD_ALLOC_DMABUF_IMAGE_MODIFIER_HI(i)] = (uint32_t)(modifiers[i] >> 32);
+   }
+
+   hdr[VTEST_CMD_LEN] = len;
+   hdr[VTEST_CMD_ID] = VCMD_ALLOC_DMABUF_IMAGE;
+   if ((ret = write_all(sock, hdr, sizeof(hdr))) ||
+       (ret = write_all(sock, req, len * sizeof(uint32_t))) ||
+       (ret = read_all(sock, hdr, sizeof(hdr))))
+      return ret;
+   if (hdr[VTEST_CMD_ID] != VCMD_ALLOC_DMABUF_IMAGE ||
+       hdr[VTEST_CMD_LEN] != VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE)
+      return -EPIPE;
+   if ((ret = read_all(sock, resp, sizeof(resp))))
+      return ret;
+
+   if (resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_ERROR])
+      return -(int)resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_ERROR];
+
+   const int fd = receive_fd(sock);
+   if (fd < 0)
+      return fd;
+
+   out->fd = fd;
+   out->modifier = resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_MODIFIER_LO] |
+                   (uint64_t)resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_MODIFIER_HI] << 32;
+   out->stride = resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_STRIDE];
+   out->offset = resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_OFFSET];
+   out->size = resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE_LO] |
+               (uint64_t)resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE_HI] << 32;
+   return 0;
+}
diff --git a/vtest_alloc_client.h b/vtest_alloc_client.h
new file mode 100644
index 0000000..3724432
--- /dev/null
+++ b/vtest_alloc_client.h
@@ -0,0 +1,52 @@
+/*
+ * Copyright 2026 waydroid-nvidia contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Minimal vtest client for VCMD_ALLOC_DMABUF_IMAGE (vtest protocol >= 6):
+ * asks the host virgl_test_server to allocate a window buffer on the host GPU
+ * and returns it as a dma-buf.  No venus context is created.
+ */
+
+#ifndef VTEST_ALLOC_CLIENT_H
+#define VTEST_ALLOC_CLIENT_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct vtest_alloc_buffer {
+   int fd;
+   uint64_t modifier;
+   uint32_t stride;
+   uint32_t offset;
+   uint64_t size;
+};
+
+/* Connects and negotiates the protocol.  Returns a socket fd, or a negative
+ * errno (-EPROTONOSUPPORT when the server is older than protocol 6).
+ */
+int
+vtest_alloc_connect(const char *socket_path, const char *client_name);
+
+/* flags: enum vcmd_alloc_dmabuf_image_flag.  modifiers may be NULL when
+ * modifier_count is 0 (any modifier the host supports).
+ * Returns 0, a negative errno from the server, or -EPIPE when the connection
+ * is broken (the caller should close and reconnect).
+ */
+int
+vtest_alloc_dmabuf_image(int sock,
+                         uint32_t width,
+                         uint32_t height,
+                         uint32_t drm_format,
+                         uint32_t flags,
+                         const uint64_t *modifiers,
+                         uint32_t modifier_count,
+                         struct vtest_alloc_buffer *out);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* VTEST_ALLOC_CLIENT_H */
diff --git a/vtest_gbm_shim.c b/vtest_gbm_shim.c
new file mode 100644
index 0000000..227f444
--- /dev/null
+++ b/vtest_gbm_shim.c
@@ -0,0 +1,270 @@
+/*
+ * Copyright 2026 waydroid-nvidia contributors
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * libgbm_mesa_wrapper.so shim for minigbm_gbm_mesa: GPU-only window buffers
+ * are allocated on the host GPU through vtest (VCMD_ALLOC_DMABUF_IMAGE) and
+ * carry the host's real DRM modifier (NVIDIA block-linear); everything else
+ * (CPU-usage buffers, mapper import/map, unsupported formats, any vtest
+ * failure) goes to the original wrapper, installed next to it as
+ * libgbm_mesa_wrapper_intel.so.
+ *
+ * Properties:
+ *   waydroid.gralloc.vtest          1 = enable (default 0: pass-through only)
+ *   waydroid.gralloc.vtest.socket   socket path (default: mesa.vtest.socket.name,
+ *                                   then /data/vtest/vtest.sock)
+ *   waydroid.gralloc.vtest.inner    inner wrapper (default
+ *                                   /vendor/lib64/libgbm_mesa_wrapper_intel.so)
+ *   waydroid.modifiers.<fourcc>.<n> allowed modifiers (set by hwcomposer from
+ *                                   the compositor); empty = any host modifier
+ */
+
+#define LOG_TAG "GBM-VTEST-SHIM"
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <stdint.h>
+
+#include "gbm_mesa_wrapper.h"
+#include "vtest_alloc_client.h"
+#include "vtest_protocol.h"
+
+/* marker for the deploy script: never install this file as the inner wrapper */
+__attribute__((used, visibility("default"))) const char vtest_gbm_shim_marker[] =
+   "vtest_gbm_shim";
+
+#ifdef __ANDROID__
+#include <android/log.h>
+#include <sys/system_properties.h>
+#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, LOG_TAG, __VA_ARGS__)
+#define LOGE(...) __android_log_print(ANDROID_LOG_ERROR, LOG_TAG, __VA_ARGS__)
+static int
+prop_get(const char *name, char *value)
+{
+   return __system_property_get(name, value);
+}
+#else
+/* host test build: properties come from the environment, with '.' -> '_' */
+#define PROP_VALUE_MAX 92
+#define LOGI(...) (fprintf(stderr, LOG_TAG ": " __VA_ARGS__), fputc('\n', stderr))
+#define LOGE(...) LOGI(__VA_ARGS__)
+static int
+prop_get(const char *name, char *value)
+{
+   char env[128];
+   snprintf(env, sizeof(env), "%s", name);
+   for (char *p = env; *p; p++) {
+      if (*p == '.')
+         *p = '_';
+   }
+   const char *v = getenv(env);
+   if (!v) {
+      value[0] = '\0';
+      return 0;
+   }
+   snprintf(value, PROP_VALUE_MAX, "%s", v);
+   return strlen(value);
+}
+#endif
+
+#define DRM_FOURCC(a, b, c, d)                                                \
+   ((uint32_t)(a) | ((uint32_t)(b) << 8) | ((uint32_t)(c) << 16) |           \
+    ((uint32_t)(d) << 24))
+
+/* single-plane formats the server maps to a VkFormat */
+static const uint32_t vtest_formats[] = {
+   DRM_FOURCC('A', 'B', '2', '4'), /* ABGR8888 */
+   DRM_FOURCC('X', 'B', '2', '4'), /* XBGR8888 */
+   DRM_FOURCC('A', 'R', '2', '4'), /* ARGB8888 */
+   DRM_FOURCC('X', 'R', '2', '4'), /* XRGB8888 */
+   DRM_FOURCC('R', 'G', '1', '6'), /* RGB565 */
+   DRM_FOURCC('A', 'B', '3', '0'), /* ABGR2101010 */
+   DRM_FOURCC('X', 'B', '3', '0'), /* XBGR2101010 */
+   DRM_FOURCC('A', 'B', '4', 'H'), /* ABGR16161616F */
+   DRM_FOURCC('X', 'B', '4', 'H'), /* XBGR16161616F */
+};
+
+#define MAX_MODIFIERS VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS
+
+static struct {
+   pthread_once_t once;
+   pthread_mutex_t lock;
+
+   struct gbm_ops *inner;
+   struct gbm_ops ops;
+
+   bool enabled;
+   char socket_path[PROP_VALUE_MAX];
+   int sock;
+   bool warned;
+
+   struct {
+      uint32_t format;
+      uint32_t count;
+      uint64_t modifiers[MAX_MODIFIERS];
+   } mod_cache[sizeof(vtest_formats) / sizeof(vtest_formats[0])];
+} shim = {
+   .once = PTHREAD_ONCE_INIT,
+   .lock = PTHREAD_MUTEX_INITIALIZER,
+   .sock = -1,
+};
+
+static int
+format_index(uint32_t drm_format)
+{
+   for (unsigned i = 0; i < sizeof(vtest_formats) / sizeof(vtest_formats[0]); i++) {
+      if (vtest_formats[i] == drm_format)
+         return i;
+   }
+   return -1;
+}
+
+/* Same props and parsing as the original wrapper's get_supported_modifiers. */
+static void
+load_modifiers(int idx, uint32_t drm_format)
+{
+   char name[PROP_VALUE_MAX];
+   char value[PROP_VALUE_MAX];
+
+   shim.mod_cache[idx].format = drm_format;
+   shim.mod_cache[idx].count = 0;
+   for (uint32_t i = 0; i < MAX_MODIFIERS; i++) {
+      snprintf(name, sizeof(name), "waydroid.modifiers.%x.%u", drm_format, i);
+      if (prop_get(name, value) < 1)
+         break;
+      shim.mod_cache[idx].modifiers[i] = strtoull(value, NULL, 16);
+      shim.mod_cache[idx].count = i + 1;
+   }
+}
+
+static int
+vtest_alloc(struct alloc_args *args)
+{
+   const int idx = format_index(args->drm_format);
+   if (idx < 0)
+      return -ENOTSUP;
+
+   pthread_mutex_lock(&shim.lock);
+
+   /* hwcomposer sets the modifier props when it connects to the compositor,
+    * which can be after our first allocation: reload until we have a list
+    */
+   if (!shim.mod_cache[idx].count)
+      load_modifiers(idx, args->drm_format);
+
+   uint32_t flags = VCMD_ALLOC_DMABUF_IMAGE_FLAG_RENDER |
+                    VCMD_ALLOC_DMABUF_IMAGE_FLAG_TEXTURE;
+   if (args->use_scanout)
+      flags |= VCMD_ALLOC_DMABUF_IMAGE_FLAG_SCANOUT;
+
+   struct vtest_alloc_buffer buf;
+   int ret = -EPIPE;
+   for (int attempt = 0; attempt < 2 && ret == -EPIPE; attempt++) {
+      if (shim.sock < 0) {
+         shim.sock = vtest_alloc_connect(shim.socket_path, "gralloc");
+         if (shim.sock < 0) {
+            ret = shim.sock;
+            shim.sock = -1;
+            break;
+         }
+      }
+      ret = vtest_alloc_dmabuf_image(shim.sock, args->width, args->height,
+                                     args->drm_format, flags,
+                                     shim.mod_cache[idx].modifiers,
+                                     shim.mod_cache[idx].count, &buf);
+      if (ret == -EPIPE) {
+         close(shim.sock);
+         shim.sock = -1;
+      }
+   }
+
+   const bool warn = ret && !shim.warned;
+   if (ret)
+      shim.warned = true;
+   pthread_mutex_unlock(&shim.lock);
+
+   if (ret) {
+      if (warn) {
+         LOGE("vtest allocation via %s failed (%s), falling back to the "
+              "inner wrapper", shim.socket_path, strerror(-ret));
+      }
+      return ret;
+   }
+
+   /* minigbm derives plane offsets itself and assumes plane 0 at 0 */
+   if (buf.offset != 0) {
+      LOGE("unexpected plane offset %u, falling back", buf.offset);
+      close(buf.fd);
+      return -EINVAL;
+   }
+
+   args->out_fd = buf.fd;
+   args->out_stride = buf.stride;
+   args->out_modifier = buf.modifier;
+   args->out_map_stride = 0;
+   return 0;
+}
+
+static int
+shim_alloc(struct alloc_args *args)
+{
+   /* CPU-usage buffers must be mappable through gbm on the guest device */
+   if (shim.enabled && !args->force_linear && !args->needs_map_stride &&
+       !vtest_alloc(args))
+      return 0;
+
+   return shim.inner->alloc(args);
+}
+
+static void
+shim_init(void)
+{
+   char value[PROP_VALUE_MAX];
+   /* by path: the renamed inner library still has the SONAME
+    * libgbm_mesa_wrapper.so, the same as ours
+    */
+   char inner_name[PROP_VALUE_MAX] = "/vendor/lib64/libgbm_mesa_wrapper_intel.so";
+
+   prop_get("waydroid.gralloc.vtest.inner", value);
+   if (value[0])
+      snprintf(inner_name, sizeof(inner_name), "%s", value);
+
+   void *lib = dlopen(inner_name, RTLD_NOW | RTLD_LOCAL);
+   struct gbm_ops *(*get_ops)(void) =
+      lib ? (struct gbm_ops * (*)(void)) dlsym(lib, "get_gbm_ops") : NULL;
+   shim.inner = get_ops ? get_ops() : NULL;
+   if (!shim.inner) {
+      LOGE("cannot load inner wrapper %s: %s", inner_name, dlerror());
+      return;
+   }
+
+   shim.ops = *shim.inner;
+   shim.ops.alloc = shim_alloc;
+
+   prop_get("waydroid.gralloc.vtest", value);
+   shim.enabled = value[0] == '1' || !strcmp(value, "true");
+
+   prop_get("waydroid.gralloc.vtest.socket", shim.socket_path);
+   if (!shim.socket_path[0])
+      prop_get("mesa.vtest.socket.name", shim.socket_path);
+   if (!shim.socket_path[0])
+      snprintf(shim.socket_path, sizeof(shim.socket_path), "/data/vtest/vtest.sock");
+
+   LOGI("inner wrapper %s, host allocation via vtest %s (%s)", inner_name,
+        shim.enabled ? "enabled" : "disabled", shim.socket_path);
+}
+
+__attribute__((visibility("default"))) struct gbm_ops *
+get_gbm_ops(void)
+{
+   pthread_once(&shim.once, shim_init);
+   return shim.inner ? &shim.ops : NULL;
+}
