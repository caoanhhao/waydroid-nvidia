diff --git a/src/venus/vkr_queue.c b/src/venus/vkr_queue.c
index 61b94bef..28c9fb0c 100644
--- a/src/venus/vkr_queue.c
+++ b/src/venus/vkr_queue.c
@@ -111,6 +111,68 @@ vkr_queue_sync_submit(struct vkr_queue *queue,
    return true;
 }
 
+int
+vkr_queue_export_sync_fd(struct vkr_queue *queue, int *out_fd)
+{
+   TRACE_FUNC();
+   struct vkr_device *dev = queue->device;
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice dev_handle = dev->base.handle.device;
+   VkResult result;
+   int ret = 0;
+
+   *out_fd = -1;
+   if (!dev->physical_device->KHR_external_fence_fd)
+      return -ENOTSUP;
+
+   mtx_lock(&queue->vk_mutex);
+
+   if (queue->export_fence == VK_NULL_HANDLE) {
+      const VkExportFenceCreateInfo export_info = {
+         .sType = VK_STRUCTURE_TYPE_EXPORT_FENCE_CREATE_INFO,
+         .handleTypes = VK_EXTERNAL_FENCE_HANDLE_TYPE_SYNC_FD_BIT,
+      };
+      const VkFenceCreateInfo create_info = {
+         .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+         .pNext = &export_info,
+      };
+      result = vk->CreateFence(dev_handle, &create_info, NULL, &queue->export_fence);
+      if (result != VK_SUCCESS) {
+         queue->export_fence = VK_NULL_HANDLE;
+         ret = -ENOMEM;
+         goto out;
+      }
+   }
+
+   /* the fence signals after all work submitted to the queue so far */
+   result = vk->QueueSubmit(queue->base.handle.queue, 0, NULL, queue->export_fence);
+   if (result != VK_SUCCESS) {
+      ret = result == VK_ERROR_DEVICE_LOST ? -ENODEV : -EIO;
+      goto out;
+   }
+
+   /* exporting a SYNC_FD resets the fence, so it can be submitted again */
+   const VkFenceGetFdInfoKHR get_fd_info = {
+      .sType = VK_STRUCTURE_TYPE_FENCE_GET_FD_INFO_KHR,
+      .fence = queue->export_fence,
+      .handleType = VK_EXTERNAL_FENCE_HANDLE_TYPE_SYNC_FD_BIT,
+   };
+   result = vk->GetFenceFdKHR(dev_handle, &get_fd_info, out_fd);
+   if (result != VK_SUCCESS) {
+      /* the fence is still pending and must not be submitted again */
+      vk->WaitForFences(dev_handle, 1, &queue->export_fence, VK_TRUE, UINT64_MAX);
+      vk->ResetFences(dev_handle, 1, &queue->export_fence);
+      *out_fd = -1;
+      ret = -EIO;
+   }
+
+out:
+   mtx_unlock(&queue->vk_mutex);
+   if (ret)
+      vkr_log("failed to export sync fd for ring_idx %u (ret %d)", queue->ring_idx, ret);
+   return ret;
+}
+
 static void
 vkr_queue_sync_thread_fini(struct vkr_queue *queue)
 {
@@ -134,6 +196,11 @@ vkr_queue_destroy(struct vkr_context *ctx, struct vkr_queue *queue)
 {
    vkr_queue_sync_thread_fini(queue);
 
+   if (queue->export_fence != VK_NULL_HANDLE) {
+      queue->device->proc_table.DestroyFence(queue->device->base.handle.device,
+                                             queue->export_fence, NULL);
+   }
+
    list_del(&queue->base.track_head);
 
    mtx_destroy(&queue->vk_mutex);
