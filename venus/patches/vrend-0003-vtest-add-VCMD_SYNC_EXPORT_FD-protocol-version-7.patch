diff --git a/src/proxy/proxy_context.c b/src/proxy/proxy_context.c
index dc23ef58..2660a939 100644
--- a/src/proxy/proxy_context.c
+++ b/src/proxy/proxy_context.c
@@ -247,6 +247,66 @@ proxy_context_submit_fence(struct virgl_context *base,
    return -1;
 }
 
+static int
+proxy_context_export_fence(struct virgl_context *base,
+                           uint32_t ring_idx,
+                           uint64_t fence_id,
+                           int *out_fd)
+{
+   struct proxy_context *ctx = (struct proxy_context *)base;
+   bool pending = false;
+
+   *out_fd = -1;
+   if (ring_idx >= PROXY_CONTEXT_TIMELINE_COUNT)
+      return -EINVAL;
+
+   /* skip the round trip when the fence is no longer pending */
+   if (proxy_renderer.flags & VIRGL_RENDERER_ASYNC_FENCE_CB)
+      mtx_lock(&ctx->timeline_mutex);
+
+   const uint32_t cur_seqno = proxy_context_load_timeline_seqno(ctx, ring_idx);
+   list_for_each_entry (struct proxy_fence, fence, &ctx->timelines[ring_idx].fences, head) {
+      if (fence->fence_id == fence_id) {
+         pending = !proxy_fence_is_signaled(fence, cur_seqno);
+         break;
+      }
+   }
+
+   if (proxy_renderer.flags & VIRGL_RENDERER_ASYNC_FENCE_CB)
+      mtx_unlock(&ctx->timeline_mutex);
+
+   if (!pending)
+      return 0;
+
+   const struct render_context_op_export_fence_request req = {
+      .header.op = RENDER_CONTEXT_OP_EXPORT_FENCE,
+      .ring_index = ring_idx,
+   };
+   if (!proxy_socket_send_request(&ctx->socket, &req, sizeof(req))) {
+      proxy_log("failed to export fence %" PRIu64, fence_id);
+      return -EIO;
+   }
+
+   struct render_context_op_export_fence_reply reply;
+   int reply_fd_count;
+   if (!proxy_socket_receive_reply_with_fds(&ctx->socket, &reply, sizeof(reply), out_fd,
+                                            1, &reply_fd_count)) {
+      proxy_log("failed to get reply of fence export %" PRIu64, fence_id);
+      *out_fd = -1;
+      return -EIO;
+   }
+
+   if (!reply_fd_count)
+      *out_fd = -1;
+
+   if (reply.ret && *out_fd >= 0) {
+      close(*out_fd);
+      *out_fd = -1;
+   }
+
+   return reply.ret;
+}
+
 static void
 proxy_context_retire_fences(struct virgl_context *base)
 {
@@ -558,6 +618,7 @@ proxy_context_init_base(struct proxy_context *ctx)
    ctx->base.get_fencing_fd = proxy_context_get_fencing_fd;
    ctx->base.retire_fences = proxy_context_retire_fences;
    ctx->base.submit_fence = proxy_context_submit_fence;
+   ctx->base.export_fence = proxy_context_export_fence;
 }
 
