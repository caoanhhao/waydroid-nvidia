+/* Export a sync_file that signals once the GPU work that will signal
+ * (sync id, value) has completed.
+ *
+ * The server finds the pending submit that signals the sync to at least
+ * value and asks the context to export a sync_file for that submit's ring.
+ * The sync_file covers all work submitted to the ring so far, so it may
+ * signal later than strictly needed but never earlier.
+ */
+#define VCMD_SYNC_EXPORT_FD_SIZE 3
+#define VCMD_SYNC_EXPORT_FD_ID 0
+#define VCMD_SYNC_EXPORT_FD_VALUE_LO 1
+#define VCMD_SYNC_EXPORT_FD_VALUE_HI 2
+
+enum vcmd_sync_export_fd_status {
+   /* the sync already reached value: no fd, use -1 */
+   VCMD_SYNC_EXPORT_FD_SIGNALED = 0,
+   /* a sync_file fd follows (SCM_RIGHTS) */
+   VCMD_SYNC_EXPORT_FD_FD = 1,
+   /* no pending submit signals the sync or the context cannot export:
+    * the client has to wait for the sync on the CPU
+    */
+   VCMD_SYNC_EXPORT_FD_UNAVAILABLE = 2,
+};
+#define VCMD_SYNC_EXPORT_FD_RESP_SIZE 1
+#define VCMD_SYNC_EXPORT_FD_RESP_STATUS 0
