+static struct vtest_timeline_submit *
+vtest_find_pending_submit(struct vtest_context *ctx,
+                          const struct vtest_sync *sync,
+                          uint64_t value,
+                          uint32_t *out_ring_idx)
+{
+   for (uint32_t ring_idx = 0; ring_idx < VTEST_MAX_TIMELINE_COUNT; ring_idx++) {
+      struct vtest_timeline *timeline = &ctx->timelines[ring_idx];
+      struct vtest_timeline_submit *submit;
+
+      /* submits retire in order, so the first match is the earliest */
+      LIST_FOR_EACH_ENTRY(submit, &timeline->submits, head) {
+         for (uint32_t i = 0; i < submit->count; i++) {
+            if (submit->syncs[i] == sync && submit->values[i] >= value) {
+               *out_ring_idx = ring_idx;
+               return submit;
+            }
+         }
+      }
+   }
+
+   return NULL;
+}
+
+/* Exporting a sync_file transfers the payload, and the client resets the
+ * sync right after.  Pending submits must then no longer signal the sync,
+ * or a later reuse of it would see a stale signal.
+ */
+static void vtest_detach_pending_sync(struct vtest_context *ctx,
+                                      struct vtest_sync *sync)
+{
+   for (uint32_t ring_idx = 0; ring_idx < VTEST_MAX_TIMELINE_COUNT; ring_idx++) {
+      struct vtest_timeline_submit *submit;
+
+      LIST_FOR_EACH_ENTRY(submit, &ctx->timelines[ring_idx].submits, head) {
+         for (uint32_t i = 0; i < submit->count; i++) {
+            if (submit->syncs[i] == sync) {
+               vtest_unref_sync(sync);
+               submit->syncs[i] = NULL;
+            }
+         }
+      }
+   }
+}
+
+int vtest_sync_export_fd(UNUSED uint32_t length_dw)
+{
+   struct vtest_context *ctx = vtest_get_current_context();
+   uint32_t req_buf[VCMD_SYNC_EXPORT_FD_SIZE];
+   uint32_t resp_buf[VTEST_HDR_SIZE + VCMD_SYNC_EXPORT_FD_RESP_SIZE];
+   struct vtest_timeline_submit *submit;
+   struct vtest_sync *sync;
+   uint32_t status;
+   uint32_t ring_idx;
+   uint64_t value;
+   int fd = -1;
+   int ret;
+
+   ret = ctx->input->read(ctx->input, req_buf, sizeof(req_buf));
+   if (ret != sizeof(req_buf))
+      return -1;
+
+   sync = util_hash_table_get(ctx->sync_table,
+                              intptr_to_pointer(req_buf[VCMD_SYNC_EXPORT_FD_ID]));
+   if (!sync)
+      return -EEXIST;
+
+   value = req_buf[VCMD_SYNC_EXPORT_FD_VALUE_LO] |
+           (uint64_t)req_buf[VCMD_SYNC_EXPORT_FD_VALUE_HI] << 32;
+
+   if (sync->value >= value) {
+      status = VCMD_SYNC_EXPORT_FD_SIGNALED;
+   } else {
+      submit = vtest_find_pending_submit(ctx, sync, value, &ring_idx);
+      if (!submit) {
+         status = VCMD_SYNC_EXPORT_FD_UNAVAILABLE;
+      } else {
+         ret = virgl_renderer_context_export_fence(ctx->ctx_id, ring_idx,
+                                                   (uintptr_t)submit, &fd);
+         if (ret)
+            status = VCMD_SYNC_EXPORT_FD_UNAVAILABLE;
+         else if (fd < 0)
+            status = VCMD_SYNC_EXPORT_FD_SIGNALED;
+         else
+            status = VCMD_SYNC_EXPORT_FD_FD;
+      }
+   }
+
+   if (status != VCMD_SYNC_EXPORT_FD_UNAVAILABLE)
+      vtest_detach_pending_sync(ctx, sync);
+
+   resp_buf[VTEST_CMD_LEN] = VCMD_SYNC_EXPORT_FD_RESP_SIZE;
+   resp_buf[VTEST_CMD_ID] = VCMD_SYNC_EXPORT_FD;
+   resp_buf[VTEST_CMD_DATA_START + VCMD_SYNC_EXPORT_FD_RESP_STATUS] = status;
+
+   ret = vtest_block_write(ctx->out_fd, resp_buf, sizeof(resp_buf));
+   if (ret >= 0 && fd >= 0)
+      ret = vtest_send_fd(ctx->out_fd, fd);
+   if (fd >= 0)
+      close(fd);
+
+   return ret < 0 ? ret : 0;
+}
