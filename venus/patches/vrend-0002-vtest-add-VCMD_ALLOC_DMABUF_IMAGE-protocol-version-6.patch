+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VTEST_VK_ALLOC_H
+#define VTEST_VK_ALLOC_H
+
+#include <stdint.h>
+
+struct vtest_vk_alloc_request {
+   uint32_t width;
+   uint32_t height;
+   uint32_t drm_format;
+   uint32_t flags; /* enum vcmd_alloc_dmabuf_image_flag */
+
+   /* allowed modifiers, e.g. the compositor's list; 0 = any the device has */
+   uint32_t modifier_count;
+   const uint64_t *modifiers;
+};
+
+struct vtest_vk_alloc_result {
+   int fd;
+   uint64_t modifier;
+   uint32_t stride;
+   uint32_t offset;
+   uint64_t size;
+};
+
+/* Allocates an exportable, device-local image on the host Vulkan device that
+ * matches render_node (or the first device with the required extensions) and
+ * exports it as a dma-buf.  The image and memory are released right away; the
+ * dma-buf keeps the allocation alive.  Returns 0 or a negative errno.
+ */
+int
+vtest_vk_alloc_dmabuf_image(const char *render_node,
+                            const struct vtest_vk_alloc_request *req,
+                            struct vtest_vk_alloc_result *out);
+
+void
+vtest_vk_alloc_fini(void);
+
+#endif /* VTEST_VK_ALLOC_H */
