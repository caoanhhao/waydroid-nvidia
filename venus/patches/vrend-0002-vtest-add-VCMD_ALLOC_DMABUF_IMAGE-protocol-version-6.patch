+int vtest_alloc_dmabuf_image(uint32_t length_dw)
+{
+   struct vtest_context *ctx = vtest_get_current_context();
+   uint32_t req_buf[VCMD_ALLOC_DMABUF_IMAGE_SIZE(VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS)];
+   uint64_t modifiers[VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS];
+   uint32_t resp_buf[VTEST_HDR_SIZE + VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE];
+   uint32_t *resp = &resp_buf[VTEST_CMD_DATA_START];
+   struct vtest_vk_alloc_result result = { .fd = -1 };
+   int ret;
+
+   if (length_dw < VCMD_ALLOC_DMABUF_IMAGE_SIZE(0) ||
+       length_dw > ARRAY_SIZE(req_buf))
+      return -EINVAL;
+
+   ret = ctx->input->read(ctx->input, req_buf, length_dw * sizeof(uint32_t));
+   if (ret != (int)(length_dw * sizeof(uint32_t)))
+      return -1;
+
+   const uint32_t count = req_buf[VCMD_ALLOC_DMABUF_IMAGE_MODIFIER_COUNT];
+   if (length_dw != VCMD_ALLOC_DMABUF_IMAGE_SIZE(count))
+      return -EINVAL;
+   for (uint32_t i = 0; i < count; i++) {
+      modifiers[i] = req_buf[VCMD_ALLOC_DMABUF_IMAGE_MODIFIER_LO(i)] |
+                     (uint64_t)req_buf[VCMD_ALLOC_DMABUF_IMAGE_MODIFIER_HI(i)] << 32;
+   }
+
+   const struct vtest_vk_alloc_request req = {
+      .width = req_buf[VCMD_ALLOC_DMABUF_IMAGE_WIDTH],
+      .height = req_buf[VCMD_ALLOC_DMABUF_IMAGE_HEIGHT],
+      .drm_format = req_buf[VCMD_ALLOC_DMABUF_IMAGE_FORMAT],
+      .flags = req_buf[VCMD_ALLOC_DMABUF_IMAGE_FLAGS],
+      .modifier_count = count,
+      .modifiers = modifiers,
+   };
+   ret = vtest_vk_alloc_dmabuf_image(renderer.rendernode_name, &req, &result);
+
+   memset(resp_buf, 0, sizeof(resp_buf));
+   resp_buf[VTEST_CMD_LEN] = VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE;
+   resp_buf[VTEST_CMD_ID] = VCMD_ALLOC_DMABUF_IMAGE;
+   resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_ERROR] = ret < 0 ? (uint32_t)-ret : 0;
+   if (!ret) {
+      resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_MODIFIER_LO] = (uint32_t)result.modifier;
+      resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_MODIFIER_HI] = (uint32_t)(result.modifier >> 32);
+      resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_STRIDE] = result.stride;
+      resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_OFFSET] = result.offset;
+      resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE_LO] = (uint32_t)result.size;
+      resp[VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE_HI] = (uint32_t)(result.size >> 32);
+   }
+
+   ret = vtest_block_write(ctx->out_fd, resp_buf, sizeof(resp_buf));
+   if (ret >= 0 && result.fd >= 0)
+      ret = vtest_send_fd(ctx->out_fd, result.fd);
+   if (result.fd >= 0)
+      close(result.fd);
+
+   return ret < 0 ? ret : 0;
+}
+
 void vtest_set_max_length(uint32_t length)
 {
    renderer.max_length = length;
