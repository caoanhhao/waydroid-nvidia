+/* VCMD_ALLOC_DMABUF_IMAGE: allocate a window buffer on the host GPU and
+ * export it as a dma-buf.  Stateless: no resource is created, the client owns
+ * the returned fd and can import it later with VCMD_RESOURCE_IMPORT_BLOB.
+ * Does not need (or create) a venus context.
+ */
+enum vcmd_alloc_dmabuf_image_flag {
+   VCMD_ALLOC_DMABUF_IMAGE_FLAG_RENDER = 1 << 0,  /* color attachment */
+   VCMD_ALLOC_DMABUF_IMAGE_FLAG_TEXTURE = 1 << 1, /* sampled */
+   VCMD_ALLOC_DMABUF_IMAGE_FLAG_SCANOUT = 1 << 2, /* given to the compositor */
+};
+
+#define VCMD_ALLOC_DMABUF_IMAGE_MAX_MODIFIERS 64
+#define VCMD_ALLOC_DMABUF_IMAGE_SIZE(count) (5 + 2 * (count))
+#define VCMD_ALLOC_DMABUF_IMAGE_WIDTH 0
+#define VCMD_ALLOC_DMABUF_IMAGE_HEIGHT 1
+#define VCMD_ALLOC_DMABUF_IMAGE_FORMAT 2 /* DRM fourcc, single plane */
+#define VCMD_ALLOC_DMABUF_IMAGE_FLAGS 3
+#define VCMD_ALLOC_DMABUF_IMAGE_MODIFIER_COUNT 4 /* 0 = any */
+#define VCMD_ALLOC_DMABUF_IMAGE_MODIFIER_LO(n) (5 + 2 * (n) + 0)
+#define VCMD_ALLOC_DMABUF_IMAGE_MODIFIER_HI(n) (5 + 2 * (n) + 1)
+
+#define VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE 7
+#define VCMD_ALLOC_DMABUF_IMAGE_RESP_ERROR 0 /* 0 or a positive errno */
+#define VCMD_ALLOC_DMABUF_IMAGE_RESP_MODIFIER_LO 1
+#define VCMD_ALLOC_DMABUF_IMAGE_RESP_MODIFIER_HI 2
+#define VCMD_ALLOC_DMABUF_IMAGE_RESP_STRIDE 3
+#define VCMD_ALLOC_DMABUF_IMAGE_RESP_OFFSET 4
+#define VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE_LO 5
+#define VCMD_ALLOC_DMABUF_IMAGE_RESP_SIZE_HI 6
+/* rsp fd (SCM_RIGHTS) only when ERROR == 0 */
+
 #endif /* VTEST_PROTOCOL */
