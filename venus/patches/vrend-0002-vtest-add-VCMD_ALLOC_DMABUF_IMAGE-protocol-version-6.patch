--- /dev/null
+++ b/vtest/vtest_vk_alloc.c
@@ -0,0 +1,513 @@
+/*
+ * Copyright 2026 waydroid-nvidia contributors
+ * SPDX-License-Identifier: MIT
+ *
+ * Host-side window buffer allocator for VCMD_ALLOC_DMABUF_IMAGE: exportable
+ * VkImages with a DRM format modifier, handed to the client as dma-bufs.
+ * Runs in the vtest server process with its own VkDevice, independent of
+ * any venus context.
+ */
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+
+#define VK_NO_PROTOTYPES
+#include "venus-protocol/vulkan_core.h"
+
+#include <drm_fourcc.h>
+
+#include "vtest_protocol.h"
+#include "vtest_vk_alloc.h"
+
+#define MAX_MODIFIERS 64
+
+#define VK_FUNCS(X)                                \
+   X(DestroyInstance)                              \
+   X(EnumeratePhysicalDevices)                     \
+   X(EnumerateDeviceExtensionProperties)           \
+   X(GetPhysicalDeviceProperties2)                 \
+   X(GetPhysicalDeviceFormatProperties2)           \
+   X(GetPhysicalDeviceImageFormatProperties2)      \
+   X(GetPhysicalDeviceMemoryProperties)            \
+   X(CreateDevice)                                 \
+   X(DestroyDevice)                                \
+   X(CreateImage)                                  \
+   X(DestroyImage)                                 \
+   X(GetImageMemoryRequirements2)                  \
+   X(GetImageSubresourceLayout)                    \
+   X(GetImageDrmFormatModifierPropertiesEXT)       \
+   X(AllocateMemory)                               \
+   X(FreeMemory)                                   \
+   X(BindImageMemory)                              \
+   X(GetMemoryFdKHR)
+
+static struct {
+   bool initialized;
+   bool ok;
+
+   void *lib;
+   PFN_vkGetInstanceProcAddr GetInstanceProcAddr;
+#define DECLARE(name) PFN_vk##name name;
+   VK_FUNCS(DECLARE)
+#undef DECLARE
+
+   VkInstance instance;
+   VkPhysicalDevice pdev;
+   VkDevice dev;
+   VkPhysicalDeviceMemoryProperties mem_props;
+} vk;
+
+static const char *const device_exts[] = {
+   VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME,
+   VK_EXT_EXTERNAL_MEMORY_DMA_BUF_EXTENSION_NAME,
+   VK_EXT_IMAGE_DRM_FORMAT_MODIFIER_EXTENSION_NAME,
+};
+
+static void
+log_msg(const char *fmt, const char *arg)
+{
+   fprintf(stderr, "vtest_vk_alloc: ");
+   fprintf(stderr, fmt, arg);
+   fprintf(stderr, "\n");
+}
+
+static bool
+has_device_ext(VkPhysicalDevice pdev, const char *name)
+{
+   uint32_t count = 0;
+   vk.EnumerateDeviceExtensionProperties(pdev, NULL, &count, NULL);
+   VkExtensionProperties *props = calloc(count, sizeof(*props));
+   if (!props)
+      return false;
+   vk.EnumerateDeviceExtensionProperties(pdev, NULL, &count, props);
+
+   bool found = false;
+   for (uint32_t i = 0; i < count && !found; i++)
+      found = !strcmp(props[i].extensionName, name);
+   free(props);
+   return found;
+}
+
+static bool
+pdev_matches_node(VkPhysicalDevice pdev, const struct stat *node)
+{
+   if (!node)
+      return true;
+   if (!has_device_ext(pdev, VK_EXT_PHYSICAL_DEVICE_DRM_EXTENSION_NAME))
+      return false;
+
+   VkPhysicalDeviceDrmPropertiesEXT drm = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRM_PROPERTIES_EXT,
+   };
+   VkPhysicalDeviceProperties2 props = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+      .pNext = &drm,
+   };
+   vk.GetPhysicalDeviceProperties2(pdev, &props);
+
+   const dev_t rdev = node->st_rdev;
+   return (drm.hasRender && drm.renderMajor == major(rdev) &&
+           drm.renderMinor == minor(rdev)) ||
+          (drm.hasPrimary && drm.primaryMajor == major(rdev) &&
+           drm.primaryMinor == minor(rdev));
+}
+
+static bool
+vk_init(const char *render_node)
+{
+   vk.lib = dlopen("libvulkan.so.1", RTLD_NOW | RTLD_LOCAL);
+   if (!vk.lib) {
+      log_msg("%s", dlerror());
+      return false;
+   }
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wpedantic"
+   /* ISO C forbids conversion of object pointer to function pointer type */
+   vk.GetInstanceProcAddr =
+      (PFN_vkGetInstanceProcAddr)dlsym(vk.lib, "vkGetInstanceProcAddr");
+#pragma GCC diagnostic pop
+   PFN_vkCreateInstance create_instance =
+      vk.GetInstanceProcAddr
+         ? (PFN_vkCreateInstance)vk.GetInstanceProcAddr(NULL, "vkCreateInstance")
+         : NULL;
+   if (!create_instance)
+      return false;
+
+   const VkApplicationInfo app = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .pApplicationName = "virgl_test_server dma-buf allocator",
+      .apiVersion = VK_API_VERSION_1_2,
+   };
+   const VkInstanceCreateInfo instance_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   if (create_instance(&instance_info, NULL, &vk.instance) != VK_SUCCESS) {
+      log_msg("%s", "vkCreateInstance failed");
+      return false;
+   }
+
+#define LOAD(name)                                                            \
+   vk.name = (PFN_vk##name)vk.GetInstanceProcAddr(vk.instance, "vk" #name);  \
+   if (!vk.name) {                                                            \
+      log_msg("missing vk%s", #name);                                         \
+      return false;                                                           \
+   }
+   VK_FUNCS(LOAD)
+#undef LOAD
+
+   struct stat node_stat;
+   const bool have_node = render_node && !stat(render_node, &node_stat);
+
+   uint32_t count = 0;
+   vk.EnumeratePhysicalDevices(vk.instance, &count, NULL);
+   VkPhysicalDevice *pdevs = calloc(count, sizeof(*pdevs));
+   if (!pdevs)
+      return false;
+   vk.EnumeratePhysicalDevices(vk.instance, &count, pdevs);
+   for (uint32_t i = 0; i < count && !vk.pdev; i++) {
+      bool usable = pdev_matches_node(pdevs[i], have_node ? &node_stat : NULL);
+      for (uint32_t j = 0; usable && j < sizeof(device_exts) / sizeof(*device_exts); j++)
+         usable = has_device_ext(pdevs[i], device_exts[j]);
+      if (usable)
+         vk.pdev = pdevs[i];
+   }
+   free(pdevs);
+   if (!vk.pdev) {
+      log_msg("no Vulkan device with dma-buf modifier export for %s",
+              render_node ? render_node : "(any)");
+      return false;
+   }
+
+   VkPhysicalDeviceProperties2 props = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+   };
+   vk.GetPhysicalDeviceProperties2(vk.pdev, &props);
+   log_msg("allocating window buffers on %s", props.properties.deviceName);
+
+   const float priority = 1.0f;
+   const VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = 0,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   const VkDeviceCreateInfo dev_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+      .enabledExtensionCount = sizeof(device_exts) / sizeof(*device_exts),
+      .ppEnabledExtensionNames = device_exts,
+   };
+   if (vk.CreateDevice(vk.pdev, &dev_info, NULL, &vk.dev) != VK_SUCCESS) {
+      log_msg("%s", "vkCreateDevice failed");
+      return false;
+   }
+
+   vk.GetPhysicalDeviceMemoryProperties(vk.pdev, &vk.mem_props);
+
+   return true;
+}
+
+static VkFormat
+drm_format_to_vk(uint32_t drm_format)
+{
+   /* DRM fourccs are little-endian packed, Vulkan UNORM8 formats are byte
+    * order: ABGR8888 is R,G,B,A in memory.
+    */
+   switch (drm_format) {
+   case DRM_FORMAT_ABGR8888:
+   case DRM_FORMAT_XBGR8888:
+      return VK_FORMAT_R8G8B8A8_UNORM;
+   case DRM_FORMAT_ARGB8888:
+   case DRM_FORMAT_XRGB8888:
+      return VK_FORMAT_B8G8R8A8_UNORM;
+   case DRM_FORMAT_RGB565:
+      return VK_FORMAT_R5G6B5_UNORM_PACK16;
+   case DRM_FORMAT_ABGR2101010:
+   case DRM_FORMAT_XBGR2101010:
+      return VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+   case DRM_FORMAT_ABGR16161616F:
+   case DRM_FORMAT_XBGR16161616F:
+      return VK_FORMAT_R16G16B16A16_SFLOAT;
+   default:
+      return VK_FORMAT_UNDEFINED;
+   }
+}
+
+static VkImageUsageFlags
+usage_from_flags(uint32_t flags)
+{
+   VkImageUsageFlags usage =
+      VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+   if (flags & (VCMD_ALLOC_DMABUF_IMAGE_FLAG_TEXTURE |
+                VCMD_ALLOC_DMABUF_IMAGE_FLAG_SCANOUT))
+      usage |= VK_IMAGE_USAGE_SAMPLED_BIT;
+   if (flags & VCMD_ALLOC_DMABUF_IMAGE_FLAG_RENDER)
+      usage |= VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+   return usage;
+}
+
+static VkFormatFeatureFlags
+features_from_usage(VkImageUsageFlags usage)
+{
+   VkFormatFeatureFlags features =
+      VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+   if (usage & VK_IMAGE_USAGE_SAMPLED_BIT)
+      features |= VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+   if (usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT)
+      features |= VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT;
+   return features;
+}
+
+static bool
+modifier_allowed(uint64_t modifier, const struct vtest_vk_alloc_request *req)
+{
+   if (!req->modifier_count)
+      return true;
+   for (uint32_t i = 0; i < req->modifier_count; i++) {
+      if (req->modifiers[i] == modifier)
+         return true;
+   }
+   return false;
+}
+
+static bool
+modifier_exportable(VkFormat format,
+                    VkImageUsageFlags usage,
+                    uint64_t modifier,
+                    const struct vtest_vk_alloc_request *req)
+{
+   const VkPhysicalDeviceImageDrmFormatModifierInfoEXT mod_info = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_DRM_FORMAT_MODIFIER_INFO_EXT,
+      .drmFormatModifier = modifier,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   const VkPhysicalDeviceExternalImageFormatInfo ext_info = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_IMAGE_FORMAT_INFO,
+      .pNext = &mod_info,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   const VkPhysicalDeviceImageFormatInfo2 info = {
+      .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_IMAGE_FORMAT_INFO_2,
+      .pNext = &ext_info,
+      .format = format,
+      .type = VK_IMAGE_TYPE_2D,
+      .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+      .usage = usage,
+   };
+   VkExternalImageFormatProperties ext_props = {
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_IMAGE_FORMAT_PROPERTIES,
+   };
+   VkImageFormatProperties2 props = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2,
+      .pNext = &ext_props,
+   };
+   if (vk.GetPhysicalDeviceImageFormatProperties2(vk.pdev, &info, &props) !=
+       VK_SUCCESS)
+      return false;
+
+   const VkExternalMemoryFeatureFlags feats =
+      ext_props.externalMemoryProperties.externalMemoryFeatures;
+   return (feats & VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT) &&
+          req->width <= props.imageFormatProperties.maxExtent.width &&
+          req->height <= props.imageFormatProperties.maxExtent.height;
+}
+
+/* Fills mods with the modifiers usable for this request, in driver order. */
+static uint32_t
+pick_modifiers(VkFormat format,
+               VkImageUsageFlags usage,
+               const struct vtest_vk_alloc_request *req,
+               uint64_t *mods)
+{
+   VkDrmFormatModifierPropertiesEXT props[MAX_MODIFIERS];
+   VkDrmFormatModifierPropertiesListEXT list = {
+      .sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT,
+      .drmFormatModifierCount = MAX_MODIFIERS,
+      .pDrmFormatModifierProperties = props,
+   };
+   VkFormatProperties2 format_props = {
+      .sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2,
+      .pNext = &list,
+   };
+   vk.GetPhysicalDeviceFormatProperties2(vk.pdev, format, &format_props);
+
+   const VkFormatFeatureFlags features = features_from_usage(usage);
+   uint32_t count = 0;
+   for (uint32_t i = 0; i < list.drmFormatModifierCount; i++) {
+      const uint64_t mod = props[i].drmFormatModifier;
+      if (props[i].drmFormatModifierPlaneCount != 1 ||
+          (props[i].drmFormatModifierTilingFeatures & features) != features ||
+          !modifier_allowed(mod, req) ||
+          !modifier_exportable(format, usage, mod, req))
+         continue;
+      mods[count++] = mod;
+   }
+   return count;
+}
+
+static uint32_t
+pick_memory_type(uint32_t type_bits)
+{
+   for (uint32_t i = 0; i < vk.mem_props.memoryTypeCount; i++) {
+      if ((type_bits & (1u << i)) &&
+          (vk.mem_props.memoryTypes[i].propertyFlags &
+           VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+         return i;
+   }
+   for (uint32_t i = 0; i < vk.mem_props.memoryTypeCount; i++) {
+      if (type_bits & (1u << i))
+         return i;
+   }
+   return UINT32_MAX;
+}
+
+int
+vtest_vk_alloc_dmabuf_image(const char *render_node,
+                            const struct vtest_vk_alloc_request *req,
+                            struct vtest_vk_alloc_result *out)
+{
+   if (!vk.initialized) {
+      vk.initialized = true;
+      vk.ok = vk_init(render_node);
+   }
+   if (!vk.ok)
+      return -ENODEV;
+
+   const VkFormat format = drm_format_to_vk(req->drm_format);
+   if (format == VK_FORMAT_UNDEFINED || !req->width || !req->height)
+      return -EINVAL;
+
+   const VkImageUsageFlags usage = usage_from_flags(req->flags);
+   uint64_t mods[MAX_MODIFIERS];
+   const uint32_t mod_count = pick_modifiers(format, usage, req, mods);
+   if (!mod_count)
+      return -ENOTSUP;
+
+   const VkImageDrmFormatModifierListCreateInfoEXT mod_list = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_LIST_CREATE_INFO_EXT,
+      .drmFormatModifierCount = mod_count,
+      .pDrmFormatModifiers = mods,
+   };
+   const VkExternalMemoryImageCreateInfo ext_info = {
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+      .pNext = &mod_list,
+      .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   const VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .pNext = &ext_info,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = format,
+      .extent = { req->width, req->height, 1 },
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+      .usage = usage,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+   };
+   VkImage image;
+   if (vk.CreateImage(vk.dev, &image_info, NULL, &image) != VK_SUCCESS)
+      return -ENOMEM;
+
+   int ret = -ENOMEM;
+   VkDeviceMemory mem = VK_NULL_HANDLE;
+
+   VkImageDrmFormatModifierPropertiesEXT mod_props = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_PROPERTIES_EXT,
+   };
+   if (vk.GetImageDrmFormatModifierPropertiesEXT(vk.dev, image, &mod_props) !=
+       VK_SUCCESS)
+      goto out;
+
+   const VkImageSubresource subres = {
+      .aspectMask = VK_IMAGE_ASPECT_MEMORY_PLANE_0_BIT_EXT,
+   };
+   VkSubresourceLayout layout;
+   vk.GetImageSubresourceLayout(vk.dev, image, &subres, &layout);
+
+   VkMemoryDedicatedRequirements dedicated_reqs = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_REQUIREMENTS,
+   };
+   VkMemoryRequirements2 reqs = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+      .pNext = &dedicated_reqs,
+   };
+   const VkImageMemoryRequirementsInfo2 reqs_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+      .image = image,
+   };
+   vk.GetImageMemoryRequirements2(vk.dev, &reqs_info, &reqs);
+
+   const uint32_t mem_type = pick_memory_type(reqs.memoryRequirements.memoryTypeBits);
+   if (mem_type == UINT32_MAX)
+      goto out;
+
+   const VkMemoryDedicatedAllocateInfo dedicated_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .image = image,
+   };
+   const VkExportMemoryAllocateInfo export_info = {
+      .sType = VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO,
+      .pNext = &dedicated_info,
+      .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   const VkMemoryAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &export_info,
+      .allocationSize = reqs.memoryRequirements.size,
+      .memoryTypeIndex = mem_type,
+   };
+   if (vk.AllocateMemory(vk.dev, &alloc_info, NULL, &mem) != VK_SUCCESS)
+      goto out;
+   if (vk.BindImageMemory(vk.dev, image, mem, 0) != VK_SUCCESS)
+      goto out;
+
+   const VkMemoryGetFdInfoKHR fd_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR,
+      .memory = mem,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   int fd = -1;
+   if (vk.GetMemoryFdKHR(vk.dev, &fd_info, &fd) != VK_SUCCESS || fd < 0)
+      goto out;
+
+   const off_t fd_size = lseek(fd, 0, SEEK_END);
+   out->fd = fd;
+   out->modifier = mod_props.drmFormatModifier;
+   out->stride = (uint32_t)layout.rowPitch;
+   out->offset = (uint32_t)layout.offset;
+   out->size = fd_size > 0 ? (uint64_t)fd_size : reqs.memoryRequirements.size;
+   ret = 0;
+
+out:
+   /* the exported dma-buf holds its own reference to the allocation */
+   if (mem != VK_NULL_HANDLE)
+      vk.FreeMemory(vk.dev, mem, NULL);
+   vk.DestroyImage(vk.dev, image, NULL);
+   return ret;
+}
+
+void
+vtest_vk_alloc_fini(void)
+{
+   if (vk.dev)
+      vk.DestroyDevice(vk.dev, NULL);
+   if (vk.instance)
+      vk.DestroyInstance(vk.instance, NULL);
+   if (vk.lib)
+      dlclose(vk.lib);
+   memset(&vk, 0, sizeof(vk));
+}
