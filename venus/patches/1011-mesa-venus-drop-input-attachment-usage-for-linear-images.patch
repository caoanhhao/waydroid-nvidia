From 7977464068c32818b92b79f4a6b6d6e512ce7b8f Mon Sep 17 00:00:00 2001
From: caoanhhao <caoanhhao2@gmail.com>
Date: Sat, 7 Nov 2026 16:47:27 +0700
Subject: [PATCH] venus: drop input attachment usage for linear images

NVIDIA rejects VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT with
VK_IMAGE_TILING_LINEAR (the format query and vkCreateImage return
VK_ERROR_FORMAT_NOT_SUPPORTED).  Venus creates images asynchronously, so
the app never sees the error: the renderer is left without the image and
crashes in the driver when the app later creates a view of it (Genshin
Impact on Vulkan creates a linear R8G8B8A8 image with color and input
attachment usage while loading the world, and the guest then aborts in
vkCreateImage on the lost ring).

Input attachments are only needed for framebuffer fetch, so drop the bit
for linear images like vn_android_ahb_image_init already does for linear
AHB images.

caoanhhao used AI to code
---
 src/virtio/vulkan/vn_image.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/virtio/vulkan/vn_image.c b/src/virtio/vulkan/vn_image.c
index d3bcb23..9ce4545 100644
--- a/src/virtio/vulkan/vn_image.c
+++ b/src/virtio/vulkan/vn_image.c
@@ -607,6 +607,20 @@ vn_CreateImage(VkDevice device,
             pCreateInfo, renderer_handle_type, &local_info);
       }
 
+      /* Some renderers (NVIDIA) reject INPUT_ATTACHMENT on linear images,
+       * and since the image is created asynchronously the app would only
+       * notice when the renderer crashes on a view of the missing image.
+       * Input attachments are only needed for framebuffer fetch, so drop
+       * the bit like vn_android_ahb_image_init does.
+       */
+      VkImageCreateInfo linear_info;
+      if (pCreateInfo->tiling == VK_IMAGE_TILING_LINEAR &&
+          (pCreateInfo->usage & VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT)) {
+         linear_info = *pCreateInfo;
+         linear_info.usage &= ~VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT;
+         pCreateInfo = &linear_info;
+      }
+
       const VkFormat app_format = pCreateInfo->format;
       struct vn_astc_image_create_info astc_info;
       const bool astc_emu = dev->physical_device->emulate_astc &&
-- 
