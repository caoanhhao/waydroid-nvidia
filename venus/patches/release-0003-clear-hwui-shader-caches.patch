diff -ru a/release/install.sh b/release/install.sh
--- a/release/install.sh	2026-11-05 15:50:19.965143263 +0700
+++ b/release/install.sh	2026-11-05 16:07:06.699226879 +0700
@@ -57,6 +57,19 @@
     sed -i "/^\[properties\]/a $1 = $2" "$CFG"
 }
 
+# Android 13 HWUI keeps a per-app Skia shader cache tagged with the GPU driver's identity.
+# When the driver changes, its BlobCache::clear() drops the entries but not the byte count,
+# so an app whose old cache was over 512 KiB crashes with SIGFPE in BlobCache::clean()
+# before it saves a new one, on every launch (venus/notes-blobcache.md). Delete the caches
+# whenever the driver changes; apps rebuild them.
+clear_shader_caches() {
+    data=$(getent passwd "${SUDO_USER:-root}" | cut -d: -f6)/.local/share/waydroid/data
+    [ -d "$data" ] || { echo "no $data: HWUI shader caches not cleared" >&2; return 0; }
+    n=$(find "$data/data" "$data/user_de" -maxdepth 4 -path '*/code_cache/com.android.skia.shaders_cache' \
+        -print -delete 2>/dev/null | wc -l)
+    echo "removed $n HWUI shader caches"
+}
+
 install_system() {
     [ "$(id -u)" = 0 ] || { echo "run the Android part with sudo: sudo sh $0 --system" >&2; exit 1; }
     LIB=/var/lib/waydroid/overlay/vendor/lib64
@@ -97,6 +110,7 @@
         del_prop "$p"
     done
 
+    clear_shader_caches
     waydroid upgrade --offline
     systemctl restart waydroid-container
     echo "=== done ($(head -1 "$D/VERSION"))"
diff -ru a/release/README.md b/release/README.md
--- a/release/README.md	2026-11-05 15:50:19.965190424 +0700
+++ b/release/README.md	2026-11-05 16:07:06.700104913 +0700
@@ -93,4 +93,11 @@
 `persist.waydroid.cursor_force_shm` is no longer set. (An init `.rc` service override did not
 work: init did not apply it.) Details: `venus/notes-cursor.md`.
 
+Fixed: the Play Store crashed on every launch (SIGFPE in libhwui `BlobCache::clean()`).
+HWUI tags each app's Skia shader cache with the GPU driver; after the switch from GLES to Vulkan
+the old cache fails that check, and Android 13's `BlobCache::clear()` keeps the old byte count.
+An app whose old cache was over 512 KiB then crashes before it saves a new one. Both
+`--system` scripts now delete `code_cache/com.android.skia.shaders_cache` for every app, and apps
+rebuild them. Details: `venus/notes-blobcache.md`.
+
 Details: `venus/notes-dmabuf.md`, `HANDOFF.md`, patches in `venus/patches/`.
