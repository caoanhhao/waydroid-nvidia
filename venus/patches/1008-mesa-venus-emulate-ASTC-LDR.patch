diff --git a/src/virtio/vulkan/vn_astc.c b/src/virtio/vulkan/vn_astc.c
new file mode 100644
index 0000000..b40eb4a
--- /dev/null
+++ b/src/virtio/vulkan/vn_astc.c
@@ -0,0 +1,347 @@
+/*
+ * Copyright 2026 caoanhhao
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vn_astc.h"
+
+#include "util/format/u_format.h"
+#include "util/texcompress_astc.h"
+#include "vk_format.h"
+
+#include "vn_buffer.h"
+#include "vn_command_buffer.h"
+#include "vn_device.h"
+#include "vn_device_memory.h"
+#include "vn_image.h"
+#include "vn_physical_device.h"
+#include "vn_renderer.h"
+
+/* staging chunks smaller than this are kept across command buffer resets */
+#define VN_ASTC_STAGING_CHUNK_SIZE (8ull * 1024 * 1024)
+
+struct vn_astc_staging {
+   VkBuffer buffer;
+   VkDeviceMemory memory;
+   uint8_t *ptr;
+   VkDeviceSize size;
+   VkDeviceSize used;
+
+   struct list_head head;
+};
+
+void
+vn_astc_fix_format_properties(VkFormatProperties2 *props2)
+{
+   /* what an ASTC texture is used for: sampling and transfers */
+   const VkFormatFeatureFlags2 allowed =
+      VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_BIT |
+      VK_FORMAT_FEATURE_2_SAMPLED_IMAGE_FILTER_LINEAR_BIT |
+      VK_FORMAT_FEATURE_2_BLIT_SRC_BIT | VK_FORMAT_FEATURE_2_TRANSFER_SRC_BIT |
+      VK_FORMAT_FEATURE_2_TRANSFER_DST_BIT;
+
+   VkFormatProperties *props = &props2->formatProperties;
+   props->linearTilingFeatures = 0;
+   props->optimalTilingFeatures &= (VkFormatFeatureFlags)allowed;
+   props->bufferFeatures = 0;
+
+   vk_foreach_struct(s, props2->pNext) {
+      switch (s->sType) {
+      case VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_3: {
+         VkFormatProperties3 *props3 = (void *)s;
+         props3->linearTilingFeatures = 0;
+         props3->optimalTilingFeatures &= allowed;
+         props3->bufferFeatures = 0;
+         break;
+      }
+      case VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT:
+         ((VkDrmFormatModifierPropertiesListEXT *)s)
+            ->drmFormatModifierCount = 0;
+         break;
+      case VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_2_EXT:
+         ((VkDrmFormatModifierPropertiesList2EXT *)s)
+            ->drmFormatModifierCount = 0;
+         break;
+      default:
+         break;
+      }
+   }
+}
+
+const VkImageCreateInfo *
+vn_astc_fix_image_create_info(const VkImageCreateInfo *create_info,
+                              struct vn_astc_image_create_info *local_info)
+{
+   local_info->create = *create_info;
+   local_info->create.format = vn_astc_emu_format(create_info->format);
+   local_info->create.flags &=
+      ~(VK_IMAGE_CREATE_BLOCK_TEXEL_VIEW_COMPATIBLE_BIT |
+        VK_IMAGE_CREATE_EXTENDED_USAGE_BIT);
+   local_info->create.pNext = NULL;
+
+   /* Only the format list is kept: the other image create structs do not
+    * apply to sampled ASTC images.  A list too long to rewrite is dropped,
+    * which keeps the image mutable to every compatible format.
+    */
+   const VkImageFormatListCreateInfo *list = vk_find_struct_const(
+      create_info->pNext, IMAGE_FORMAT_LIST_CREATE_INFO);
+   if (list && list->viewFormatCount &&
+       list->viewFormatCount <= ARRAY_SIZE(local_info->view_formats)) {
+      for (uint32_t i = 0; i < list->viewFormatCount; i++) {
+         const VkFormat format = list->pViewFormats[i];
+         local_info->view_formats[i] =
+            vn_format_is_astc_ldr(format) ? vn_astc_emu_format(format)
+                                          : format;
+      }
+      local_info->format_list = (VkImageFormatListCreateInfo){
+         .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_LIST_CREATE_INFO,
+         .viewFormatCount = list->viewFormatCount,
+         .pViewFormats = local_info->view_formats,
+      };
+      local_info->create.pNext = &local_info->format_list;
+   }
+
+   return &local_info->create;
+}
+
+static void
+vn_astc_staging_free(struct vn_device *dev, struct vn_astc_staging *staging)
+{
+   VkDevice dev_handle = vn_device_to_handle(dev);
+
+   list_del(&staging->head);
+   vn_DestroyBuffer(dev_handle, staging->buffer, NULL);
+   vn_FreeMemory(dev_handle, staging->memory, NULL);
+   vk_free(&dev->base.vk.alloc, staging);
+}
+
+static struct vn_astc_staging *
+vn_astc_staging_alloc(struct vn_device *dev, VkDeviceSize size)
+{
+   const VkPhysicalDeviceMemoryProperties *mem_props =
+      &dev->physical_device->memory_properties;
+   VkDevice dev_handle = vn_device_to_handle(dev);
+   VkResult result;
+
+   struct vn_astc_staging *staging =
+      vk_zalloc(&dev->base.vk.alloc, sizeof(*staging), VN_DEFAULT_ALIGN,
+                VK_SYSTEM_ALLOCATION_SCOPE_DEVICE);
+   if (!staging)
+      return NULL;
+   list_inithead(&staging->head);
+   staging->size = size;
+
+   const VkBufferCreateInfo buf_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = size,
+      .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   result = vn_CreateBuffer(dev_handle, &buf_info, NULL, &staging->buffer);
+   if (result != VK_SUCCESS)
+      goto fail;
+
+   const VkBufferMemoryRequirementsInfo2 reqs_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_REQUIREMENTS_INFO_2,
+      .buffer = staging->buffer,
+   };
+   VkMemoryRequirements2 reqs = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+   };
+   vn_GetBufferMemoryRequirements2(dev_handle, &reqs_info, &reqs);
+
+   const VkMemoryPropertyFlags wanted = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                        VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   uint32_t mem_type = UINT32_MAX;
+   u_foreach_bit(i, reqs.memoryRequirements.memoryTypeBits) {
+      if ((mem_props->memoryTypes[i].propertyFlags & wanted) == wanted) {
+         mem_type = i;
+         break;
+      }
+   }
+   if (mem_type == UINT32_MAX)
+      goto fail;
+
+   const VkMemoryAllocateInfo mem_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = reqs.memoryRequirements.size,
+      .memoryTypeIndex = mem_type,
+   };
+   result = vn_AllocateMemory(dev_handle, &mem_info, NULL, &staging->memory);
+   if (result != VK_SUCCESS)
+      goto fail;
+
+   const VkBindBufferMemoryInfo bind_info = {
+      .sType = VK_STRUCTURE_TYPE_BIND_BUFFER_MEMORY_INFO,
+      .buffer = staging->buffer,
+      .memory = staging->memory,
+   };
+   vn_BindBufferMemory2(dev_handle, 1, &bind_info);
+
+   const VkMemoryMapInfo map_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_MAP_INFO,
+      .memory = staging->memory,
+      .size = VK_WHOLE_SIZE,
+   };
+   result = vn_MapMemory2(dev_handle, &map_info, (void **)&staging->ptr);
+   if (result != VK_SUCCESS)
+      goto fail;
+
+   return staging;
+
+fail:
+   if (staging->buffer)
+      vn_DestroyBuffer(dev_handle, staging->buffer, NULL);
+   if (staging->memory)
+      vn_FreeMemory(dev_handle, staging->memory, NULL);
+   vk_free(&dev->base.vk.alloc, staging);
+   return NULL;
+}
+
+/* Returns the CPU address of the buffer contents, or NULL when the buffer is
+ * not bound to memory the guest has mapped.
+ */
+static const uint8_t *
+vn_astc_map_buffer(struct vn_device *dev,
+                   const struct vn_buffer *buf,
+                   VkDeviceSize size)
+{
+   struct vn_device_memory *mem = buf->astc.bound_mem;
+   if (!mem || !mem->base_bo ||
+       buf->astc.bound_offset + size > mem->base.vk.size)
+      return NULL;
+
+   uint8_t *ptr = vn_renderer_bo_map(dev->renderer, mem->base_bo, NULL);
+   if (!ptr)
+      return NULL;
+
+   vn_renderer_bo_invalidate(dev->renderer, mem->base_bo,
+                             buf->astc.bound_offset, size);
+   return ptr + buf->astc.bound_offset;
+}
+
+bool
+vn_astc_decode_copy(struct vn_command_buffer *cmd,
+                    VkBuffer src_buffer,
+                    const struct vn_image *dst_img,
+                    uint32_t region_count,
+                    const VkBufferImageCopy *regions,
+                    VkBuffer *out_buffer,
+                    VkBufferImageCopy *out_regions)
+{
+   struct vn_device *dev = vn_device_from_vk(cmd->base.vk.pool->base.device);
+   const struct vn_buffer *buf = vn_buffer_from_handle(src_buffer);
+   const VkFormat format = dst_img->astc_emu_format;
+   const enum pipe_format pformat = vk_format_to_pipe_format(format);
+   const struct util_format_description *desc =
+      util_format_description(pformat);
+   const uint32_t blk_w = desc->block.width;
+   const uint32_t blk_h = desc->block.height;
+
+   /* source footprint and decoded size of each region */
+   VkDeviceSize src_end = 0;
+   VkDeviceSize dst_size = 0;
+   for (uint32_t i = 0; i < region_count; i++) {
+      const VkBufferImageCopy *r = &regions[i];
+      const uint32_t row_len =
+         r->bufferRowLength ? r->bufferRowLength : r->imageExtent.width;
+      const uint32_t img_h =
+         r->bufferImageHeight ? r->bufferImageHeight : r->imageExtent.height;
+      const uint32_t layers = vk_image_subresource_layer_count(
+         &dst_img->base.vk, &r->imageSubresource);
+      const VkDeviceSize src_stride = DIV_ROUND_UP(row_len, blk_w) * 16;
+      const VkDeviceSize src_layer = DIV_ROUND_UP(img_h, blk_h) * src_stride;
+      const uint32_t depth = MAX2(r->imageExtent.depth, 1) * layers;
+
+      src_end = MAX2(src_end, r->bufferOffset + src_layer * depth);
+      dst_size += align64((VkDeviceSize)r->imageExtent.width *
+                             r->imageExtent.height * 4 * depth,
+                          16);
+   }
+
+   const uint8_t *src = vn_astc_map_buffer(dev, buf, src_end);
+   if (!src) {
+      vn_log(dev->instance, "ASTC upload from an unmapped buffer; skipped");
+      return false;
+   }
+
+   struct vn_astc_staging *staging = NULL;
+   if (!list_is_empty(&cmd->astc_staging)) {
+      staging =
+         list_last_entry(&cmd->astc_staging, struct vn_astc_staging, head);
+      if (staging->size - staging->used < dst_size)
+         staging = NULL;
+   }
+   if (!staging) {
+      staging =
+         vn_astc_staging_alloc(dev, MAX2(dst_size, VN_ASTC_STAGING_CHUNK_SIZE));
+      if (!staging) {
+         cmd->base.vk.state = MESA_VK_COMMAND_BUFFER_STATE_INVALID;
+         return false;
+      }
+      list_addtail(&staging->head, &cmd->astc_staging);
+   }
+
+   VkDeviceSize offset = staging->used;
+   for (uint32_t i = 0; i < region_count; i++) {
+      const VkBufferImageCopy *r = &regions[i];
+      const uint32_t row_len =
+         r->bufferRowLength ? r->bufferRowLength : r->imageExtent.width;
+      const uint32_t img_h =
+         r->bufferImageHeight ? r->bufferImageHeight : r->imageExtent.height;
+      const uint32_t layers = vk_image_subresource_layer_count(
+         &dst_img->base.vk, &r->imageSubresource);
+      const uint32_t width = r->imageExtent.width;
+      const uint32_t height = r->imageExtent.height;
+      const VkDeviceSize src_stride = DIV_ROUND_UP(row_len, blk_w) * 16;
+      const VkDeviceSize src_layer = DIV_ROUND_UP(img_h, blk_h) * src_stride;
+      const VkDeviceSize dst_layer = (VkDeviceSize)width * height * 4;
+      const uint32_t depth = MAX2(r->imageExtent.depth, 1) * layers;
+
+      for (uint32_t z = 0; z < depth; z++) {
+         _mesa_unpack_astc_2d_ldr(staging->ptr + offset + dst_layer * z,
+                                  width * 4,
+                                  src + r->bufferOffset + src_layer * z,
+                                  src_stride, width, height, pformat);
+      }
+
+      out_regions[i] = *r;
+      out_regions[i].bufferOffset = offset;
+      out_regions[i].bufferRowLength = 0;
+      out_regions[i].bufferImageHeight = 0;
+
+      offset += align64(dst_layer * depth, 16);
+   }
+   staging->used = offset;
+
+   *out_buffer = staging->buffer;
+   return true;
+}
+
+void
+vn_astc_cmd_reset(struct vn_command_buffer *cmd)
+{
+   struct vn_device *dev = vn_device_from_vk(cmd->base.vk.pool->base.device);
+   bool kept = false;
+
+   /* keep one default-sized chunk for the next recording */
+   list_for_each_entry_safe(struct vn_astc_staging, staging,
+                            &cmd->astc_staging, head) {
+      if (!kept && staging->size == VN_ASTC_STAGING_CHUNK_SIZE) {
+         staging->used = 0;
+         kept = true;
+         continue;
+      }
+      vn_astc_staging_free(dev, staging);
+   }
+}
+
+void
+vn_astc_cmd_fini(struct vn_command_buffer *cmd)
+{
+   struct vn_device *dev = vn_device_from_vk(cmd->base.vk.pool->base.device);
+
+   list_for_each_entry_safe(struct vn_astc_staging, staging,
+                            &cmd->astc_staging, head)
+      vn_astc_staging_free(dev, staging);
+}
