+/*
+ * Copyright 2026 caoanhhao
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef VN_ASTC_H
+#define VN_ASTC_H
+
+#include "vn_common.h"
+
+/* ASTC LDR emulation for renderers without textureCompressionASTC_LDR
+ * (e.g. desktop NVIDIA).  Emulated images are created on the renderer as
+ * R8G8B8A8_UNORM/SRGB and buffer-to-image copies are decoded on the CPU at
+ * record time into a per-command-buffer staging buffer.
+ */
+
+struct vn_command_buffer;
+struct vn_image;
+
+static inline bool
+vn_format_is_astc_ldr(VkFormat format)
+{
+   return format >= VK_FORMAT_ASTC_4x4_UNORM_BLOCK &&
+          format <= VK_FORMAT_ASTC_12x12_SRGB_BLOCK;
+}
+
+static inline VkFormat
+vn_astc_emu_format(VkFormat format)
+{
+   /* ASTC UNORM/SRGB formats alternate, UNORM first */
+   return (format - VK_FORMAT_ASTC_4x4_UNORM_BLOCK) & 1
+             ? VK_FORMAT_R8G8B8A8_SRGB
+             : VK_FORMAT_R8G8B8A8_UNORM;
+}
+
+void
+vn_astc_fix_format_properties(VkFormatProperties2 *props);
+
+struct vn_astc_image_create_info {
+   VkImageCreateInfo create;
+   VkImageFormatListCreateInfo format_list;
+   VkFormat view_formats[8];
+};
+
+const VkImageCreateInfo *
+vn_astc_fix_image_create_info(const VkImageCreateInfo *create_info,
+                              struct vn_astc_image_create_info *local_info);
+
+bool
+vn_astc_decode_copy(struct vn_command_buffer *cmd,
+                    VkBuffer src_buffer,
+                    const struct vn_image *dst_img,
+                    uint32_t region_count,
+                    const VkBufferImageCopy *regions,
+                    VkBuffer *out_buffer,
+                    VkBufferImageCopy *out_regions);
+
+void
+vn_astc_cmd_reset(struct vn_command_buffer *cmd);
+
+void
+vn_astc_cmd_fini(struct vn_command_buffer *cmd);
+
+#endif /* VN_ASTC_H */
