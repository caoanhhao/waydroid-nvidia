@@ -863,6 +863,27 @@ vtest_wait(struct vn_renderer *renderer, const struct vn_renderer_wait *wait)
    return result;
 }
 
+static int
+vtest_sync_export_syncobj(struct vn_renderer *renderer,
+                          struct vn_renderer_sync *sync,
+                          bool sync_file)
+{
+   /* vtest has no sync_file side channel.  Wait for the sync to be signaled
+    * (exportable syncs are signaled with value 1 on submit) and hand out -1,
+    * which is a valid sync file referring to an already signaled object.
+    */
+   const uint64_t val = 1;
+   const struct vn_renderer_wait wait = {
+      .timeout = UINT64_MAX,
+      .syncs = &sync,
+      .sync_values = &val,
+      .sync_count = 1,
+   };
+   vtest_wait(renderer, &wait);
+
+   return -1;
+}
+
 static VkResult
 vtest_submit(struct vn_renderer *renderer,
              const struct vn_renderer_submit_batch *batch)
